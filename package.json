{
  "name": "prime-cuts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "web",
    "services"
  ],
  "scripts": {
    "dev": "concurrently --kill-others -n \"SERVICES,WEB\" -c \"blue,green\" \"npm run dev:services\" \"npm run dev:web\"",
    "dev:services": "npm --prefix services run dev",
    "dev:web": "node scripts/wait-server.js && npm --prefix web run dev",
    "build": "npm run build:services && npm run build:web",
    "build:services": "npm --prefix services run build",
    "build:web": "npm --prefix web run build",
    "start": "npm --prefix services run start",
    "install:all": "npm install && npm --prefix web install && npm --prefix services install",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@react-oauth/google": "^0.13.5",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "framer-motion": "^12.42.0",
    "jose": "^6.2.10",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.34.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.1.5",
    "web-push": "^3.6.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.8",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
